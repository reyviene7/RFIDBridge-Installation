# Warehouse Fitness — RFID Bridge Configuration
# Fill in your values below, then save this file as ".env"

# ESP32 Serial Port (check Device Manager if unsure)
SERIAL_PORT=COM11

# Serial baud rate (do not change unless you changed it in the Arduino sketch)
BAUD_RATE=115200

# HTTP port for the /open-door API (used by the web app)
HTTP_PORT=8765

# Supabase credentials (get these from your Supabase project settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
